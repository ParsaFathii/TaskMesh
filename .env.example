# TaskMesh — environment variable template
# Copy to the location your deployment expects (for docker compose, a .env next to
# deploy/compose/docker-compose.yml or exported in your shell) and fill in real
# values. Never commit real secrets.

# ---------------------------------------------------------------- backend ----
# JDBC URL of the PostgreSQL instance. Local dev default uses port 5433; the
# compose stack uses postgres:5432.
TASKMESH_DB_URL=jdbc:postgresql://localhost:5433/taskmesh
TASKMESH_DB_USER=taskmesh

# Local dev against the bundled PostgreSQL may use trust auth (empty password).
# In compose this MUST be set (compose fails fast if missing) — pick a strong one.
TASKMESH_DB_PASSWORD=

# HMAC secret for JWT signing. Generate e.g. with: openssl rand -base64 48
# The backend logs a WARN at startup when the default value is left in place —
# never leave the default anywhere reachable by others.
TASKMESH_JWT_SECRET=change-me-openssl-rand-base64-48

# Root directory for file job results.
# IMPORTANT: backend and workers must point at the SAME directory (same host path
# or the same shared volume, e.g. the taskmesh-data volume in compose). If they
# differ, workers write result files the backend cannot serve (404s).
TASKMESH_STORAGE_DIR=./data

# HTTP port of the API (compose maps this to 8080).
TASKMESH_SERVER_PORT=8080

# Comma-separated allowed CORS origins (defaults to the Vite dev server).
TASKMESH_CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------- worker ----
# Python connection string for the same database.
TASKMESH_DATABASE_URL=postgresql://taskmesh@localhost:5433/taskmesh

# Comma-separated job types this worker claims. Leave UNSET to claim all 7 types
# (an empty-but-exported value would claim none). Types:
# csv_analysis,json_transform,image_resize,hash_sha256,text_statistics,archive_inspection,cpu_benchmark
# TASKMESH_CAPABILITIES=

# Heartbeat + lease renewal interval in seconds (default 10).
TASKMESH_HEARTBEAT_INTERVAL_S=10

# Extra seconds added when renewing a job lease (default 15).
TASKMESH_LEASE_MARGIN_S=15

# Control API port of THIS worker instance. Use a distinct port per worker
# (9100, 9101, ...) when running several workers on one host.
TASKMESH_CONTROL_PORT=9100

# Worker name shown in the workers table (default: <hostname>-<pid> when unset).
# TASKMESH_WORKER_NAME=

# MUST match TASKMESH_STORAGE_DIR of the backend (see note above).
# TASKMESH_STORAGE_DIR=./data

# -------------------------------------------------------------------- web ----
# REST base URL for the web console build. Keep it relative (/api/v1) behind the
# Vite dev proxy or the nginx container; set an absolute URL only if the API is on
# another origin.
# VITE_API_BASE=/api/v1
