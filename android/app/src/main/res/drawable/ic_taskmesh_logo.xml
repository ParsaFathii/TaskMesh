    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Graphite background -->
    <path
        android:fillColor="#101418"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Mesh edges -->
    <path
        android:strokeColor="#F5A623"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,70L54,36L70,70Z" />
    <path
        android:strokeColor="#2EA043"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M38,70L54,70" />

    <!-- Nodes -->
    <path
        android:fillColor="#F5A623"
        android:pathData="M38,70m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <path
        android:fillColor="#F5A623"
        android:pathData="M54,36m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <path
        android:fillColor="#F5A623"
        android:pathData="M70,70m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <!-- Center node: a job flowing through the mesh -->
    <path
        android:fillColor="#2EA043"
        android:pathData="M54,70m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
